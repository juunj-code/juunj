name = "검사 아이라"
description = "탑에 처음 들어온 자를 언제나 마중 나오는 검사."
backstory = "탑에 발을 들이는 모두를 가장 먼저 맞이하는 검사. 왜 이 일을 하냐는 질문엔 매번 같은 대답만 돌아온다 — \"누군가는 해야 하니까.\" 그 대답 뒤에 무엇을 숨기고 있는지는, 아직 누구도 물어본 적이 없다."
meeting_line = "\"또 한 명 왔네. 나쁘지 않은 시작이야.\""
